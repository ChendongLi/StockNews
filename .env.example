# Comma-separated recipient emails
RECIPIENTS=you@gmail.com,other@gmail.com

# AgentMail API key (https://agentmail.to)
AGENTMAIL_API_KEY=am_us_...

# Anthropic API key (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-...

# Brave Search API key (https://api.search.brave.com — free tier: 2000 req/month)
BRAVE_API_KEY=BSA...

# GCS static dashboard (leave empty to skip upload)
GCS_DASHBOARD_BUCKET=market-espresso-dashboard
GCS_DASHBOARD_PATH=index.html

# Optional overrides
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# LOG_FILE=logs/stock_news.log
# STOCKS_CONFIG_PATH=stocks.yaml
